# Copy this file to .env and fill in real values:
#
#     cp .env.example .env
#
# .env is gitignored. Never commit real secrets.

# --- Database ---------------------------------------------------------------

# The application database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastapi_db

# The test suite drops and recreates every table in this database on each run,
# so it must never point at the same database as DATABASE_URL. init-db.sh
# creates it when the postgres volume is first initialized.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastapi_test_db

# --- JWT --------------------------------------------------------------------

# Required. There is no default: the app refuses to start without these, so a
# missing value cannot silently ship a publicly-known signing key.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-generate-a-random-32-byte-value
JWT_REFRESH_SECRET_KEY=change-me-generate-a-different-random-32-byte-value

# Signing algorithm for both token types.
ALGORITHM=HS256

# Access token lifetime, in minutes. Reported to the client as expires_at.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime, in days.
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security ---------------------------------------------------------------

# bcrypt work factor. Higher is slower and stronger; 12 is the current default.
BCRYPT_ROUNDS=12
